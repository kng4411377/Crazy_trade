# Environment Variables for Crazy Trade Bot
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Note: You can use either .env OR secrets.yaml - not both needed

# Alpaca Trading API
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Gemini AI (Optional - for AI analysis layer)
GEMINI_API_KEY=your_gemini_api_key_here

# Feature Toggles (can also be set in config.yaml)
STOCKS_ENABLED=true
CRYPTO_ENABLED=true
GEMINI_ENABLED=true

# Logging Level
LOG_LEVEL=INFO
