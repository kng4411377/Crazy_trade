# Crypto-Only Trading Bot Configuration (EXAMPLE TEMPLATE)
#
# ⚠️  DO NOT EDIT THIS FILE DIRECTLY!
#
# Setup Instructions:
#   1. Copy this file: cp config.crypto.yaml.example config.crypto.yaml
#   2. Copy secrets: cp secrets.yaml.example secrets.yaml
#   3. Edit config.crypto.yaml with your crypto settings
#   4. Edit secrets.yaml with your Alpaca API keys
#   5. config.crypto.yaml and secrets.yaml are gitignored - your changes stay local
#   6. Run with: python main.py config.crypto.yaml
#
# This config trades ONLY crypto (24/7)
# See docs/CRYPTO_GUIDE.md for full crypto trading documentation

mode: "paper"          # "paper" | "live"

# Stock watchlist (empty for crypto-only bot)
watchlist: []

# Crypto watchlist (trades 24/7)
# ✅ ALL cryptos below are VERIFIED to work on Alpaca Paper Trading
# Note: Alpaca crypto is available 24/7, no market hours restrictions
crypto_watchlist:
  - "BTC/USD"      # Bitcoin (most liquid)
  - "ETH/USD"      # Ethereum (most liquid)
  - "DOGE/USD"     # Dogecoin (high volatility!)
  - "SHIB/USD"     # Shiba Inu (high volatility!)
  # ❌ MATIC (Polygon) is NOT available on Alpaca
  # Other supported cryptos you can add:
  # - "SOL/USD"    # Solana
  # - "LINK/USD"   # Chainlink
  # - "XRP/USD"    # Ripple
  # - "LTC/USD"    # Litecoin
  # - "AVAX/USD"   # Avalanche
  # - "UNI/USD"    # Uniswap
  # - "BCH/USD"    # Bitcoin Cash
  # - "DOT/USD"    # Polkadot

allocation:
  # Crypto-specific allocation (can be higher since 24/7 trading)
  total_usd_cap: 10000
  per_symbol_usd: 500         # $500 per crypto
  per_symbol_override:
    "BTC/USD": 1000           # Bitcoin gets more allocation
    "ETH/USD": 1000           # Ethereum gets more allocation
  min_cash_reserve_percent: 20  # Keep more cash for volatility
  allow_fractional: true        # Crypto supports fractional shares

entries:
  type: "buy_stop"
  buy_stop_pct_above_last: 3.0  # Entry trigger is base_price * (1 + this %)
  stop_limit_max_slip_pct: 1.0
  
  # Entry price calculation strategy:
  # - "current": Use current spot price (best for 24/7 crypto - most responsive)
  # - "sma": Use Simple Moving Average of last N closing prices (smoother)
  # - "opening": Use today's opening price (not recommended for crypto - stale quickly)
  entry_price_strategy: "current"
  sma_periods: 10               # Only used if entry_price_strategy = "sma"
  
  tif: "GTC"                    # Time-in-force: "GTC" (good till cancelled) for 24/7 crypto trading
                                 # GTC keeps orders active until filled or manually cancelled
                                 # (crypto has no market close, so GTC is typical)
  cancel_at_close: false        # No market close for crypto
  rearm_next_session: false     # Always active

stops:
  trailing_stop_pct: 8.0        # Tighter stop for crypto volatility
  use_trailing_limit: false
  trail_limit_offset_pct: 0.2
  tif: "GTC"

hours:
  calendar: "XNYS"              # Not used for crypto, but required
  allow_pre_market: false
  allow_after_hours: false
  skip_first_minutes: 0         # Crypto trades 24/7, no need to skip
  skip_last_minutes: 0          # Crypto trades 24/7, no need to skip

cooldowns:
  after_stopout_minutes: 1440   # Wait at least 1 day (1440 min) before re-entering after stop-out
                                 # Prevents revenge trading and overtrading
                                 # Even for crypto, wait a full day after stop-out

polling:
  price_seconds: 10
  orders_seconds: 10            # Check more frequently for crypto
  keepalive_seconds: 300
  event_check_seconds: 3        # Faster event checking

risk:
  max_total_exposure_usd: 10000
  max_symbol_exposure_usd: 1500
  max_daily_loss_pct: 5.0       # Circuit breaker: Crypto is more volatile, allow 5%
  max_daily_loss_usd: 500       # Circuit breaker: Stop if daily loss > $500
  max_concurrent_positions: 8   # Allow more crypto positions (24/7 trading)

persistence:
  db_url: "sqlite:///bot_crypto.db"  # Separate DB for crypto

logging:
  level: "INFO"

alerts:
  webhook: null


