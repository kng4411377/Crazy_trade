# ==============================================================================
# CRAZY TRADE BOT - UNIFIED CONFIGURATION
# ==============================================================================
#
# DO NOT EDIT THIS FILE DIRECTLY!
#
# Setup Instructions:
#   1. Copy this file:    cp config.yaml.example config.yaml
#   2. Copy secrets:      cp secrets.yaml.example secrets.yaml
#   3. Edit config.yaml with your settings
#   4. Edit secrets.yaml with your Alpaca API keys
#
# Both config.yaml and secrets.yaml are gitignored - your changes stay local.
# See docs/QUICKSTART.md for detailed setup instructions.
#
# ==============================================================================


# ------------------------------------------------------------------------------
# SECTION 1: CORE SETTINGS
# ------------------------------------------------------------------------------

mode: "paper"          # "paper" | "live" - START WITH PAPER!


# ------------------------------------------------------------------------------
# SECTION 2: STOCK WATCHLIST
# ------------------------------------------------------------------------------
# Stocks trade during market hours only (9:30 AM - 4:00 PM ET)

watchlist: 
  - "AAPL"
  - "TSLA"
  - "NVDA"
  - "AMD"
  - "MSFT"


# ------------------------------------------------------------------------------
# SECTION 3: POSITION SIZING & ALLOCATION
# ------------------------------------------------------------------------------

allocation:
  total_usd_cap: 50000           # Max total capital to deploy
  per_symbol_usd: 1000           # Default budget per symbol
  per_symbol_override: {}        # Override per symbol: {"TSLA": 1500, "NVDA": 2000}
  min_cash_reserve_percent: 10   # Keep 10% cash buffer
  allow_fractional: false        # Set to true for crypto or fractional shares


# ------------------------------------------------------------------------------
# SECTION 4: ENTRY STRATEGY
# ------------------------------------------------------------------------------

entries:
  type: "buy_stop"               # "buy_stop" | "buy_stop_limit"
  buy_stop_pct_above_last: 5.0   # Entry trigger = base_price * (1 + 5%)
  stop_limit_max_slip_pct: 1.0   # Max slippage (only for buy_stop_limit)
  
  # Entry price calculation:
  # - "current": Use current spot price (most responsive)
  # - "sma": Use Simple Moving Average (smoother, less noise)
  # - "opening": Use today's opening price (stable all day)
  entry_price_strategy: "current"
  sma_periods: 10                # Only used if strategy = "sma"
  
  tif: "DAY"                     # "DAY" = cancel at close | "GTC" = good till cancelled
  cancel_at_close: true
  rearm_next_session: true       # Auto-place new order next trading day


# ------------------------------------------------------------------------------
# SECTION 5: EXIT STRATEGY (TRAILING STOPS)
# ------------------------------------------------------------------------------

stops:
  trailing_stop_pct: 10.0        # Trail 10% from peak price
  use_trailing_limit: false      # Use trailing limit instead of stop
  trail_limit_offset_pct: 0.2    # Limit offset (if above is true)
  tif: "GTC"                     # "GTC" keeps stop active until filled


# ------------------------------------------------------------------------------
# SECTION 6: RISK MANAGEMENT
# ------------------------------------------------------------------------------

risk:
  max_total_exposure_usd: 20000  # Max total portfolio exposure
  max_symbol_exposure_usd: 2000  # Max exposure per symbol
  max_daily_loss_pct: 3.0        # Circuit breaker: stop if daily loss > 3%
  max_daily_loss_usd: 500        # Circuit breaker: stop if daily loss > $500
  max_concurrent_positions: 5    # Max positions at once

cooldowns:
  after_stopout_minutes: 1440    # Wait 24hr after stop-out (prevents revenge trading)


# ------------------------------------------------------------------------------
# SECTION 7: MARKET HOURS (STOCKS)
# ------------------------------------------------------------------------------

hours:
  calendar: "XNYS"               # NYSE calendar
  allow_pre_market: false        # Trade in pre-market?
  allow_after_hours: false       # Trade after hours?
  skip_first_minutes: 5          # Skip first 5 min (opening volatility)
  skip_last_minutes: 10          # Skip last 10 min (closing volatility)


# ------------------------------------------------------------------------------
# SECTION 8: POLLING & SYSTEM
# ------------------------------------------------------------------------------

polling:
  price_seconds: 10              # Check prices every 10 sec
  orders_seconds: 15             # Check orders every 15 sec
  keepalive_seconds: 300         # Ping Alpaca every 5 min
  event_check_seconds: 5         # Check for fills every 5 sec

persistence:
  db_url: "sqlite:///bot.db"

logging:
  level: "INFO"                  # "DEBUG" for verbose output

alerts:
  webhook: null                  # Optional: Slack/Discord webhook URL


# ==============================================================================
# MOMENTUM INTELLIGENCE LAYER
# ==============================================================================
# Auto-discover trending stocks based on Reddit/WSB buzz and volume anomalies.
# All data providers are FREE - no API keys required!

momentum:
  enabled: false                 # Master toggle for momentum features

  # --------------------------------------------------------------------------
  # MOMENTUM FILTER (Filter your watchlist)
  # --------------------------------------------------------------------------
  # Filters your watchlist at startup, only trading stocks with momentum signals
  
  filter:
    enabled: false               # Enable momentum filtering
    min_score: 0.4               # Minimum momentum score to trade (0-1)
    volume_weight: 0.7           # Weight for volume anomaly
    reddit_weight: 0.3           # Weight for Reddit buzz
    cache_duration: 3600         # Cache scores for 1 hour
    require_volume: true         # Must have volume data
    require_reddit: false        # Reddit data optional
    fail_open: true              # On error, include symbol (safe)
  
  # --------------------------------------------------------------------------
  # DYNAMIC WATCHLIST (Auto-discover stocks)
  # --------------------------------------------------------------------------
  # Automatically discovers and adds trending stocks to your watchlist
  
  dynamic_watchlist:
    enabled: false               # Enable auto-discovery
    update_interval: 3600        # Re-scan every hour (seconds)
    scan_at_start: true          # Scan when bot starts
    
    # Discovery sources
    use_reddit_trending: true    # Include top Reddit/WSB stocks
    use_volume_movers: true      # Include high volume stocks
    use_config_watchlist: true   # Also include stocks from watchlist above
    
    # Position limits
    max_positions: 5             # Max simultaneous positions
    max_watchlist_size: 20       # Max symbols to track
    
    # Scoring thresholds
    min_score_to_add: 0.5        # Must score this high to be added
    min_score_to_keep: 0.3       # Remove if score drops below
    
    # Stock filters
    min_price: 5.0               # No penny stocks
    max_price: 1000.0            # Max stock price
    min_volume: 500000           # Min daily volume
    exclude_otc: true            # Exclude OTC/pink sheets
    
    # Control lists
    always_include: []           # Always trade these: ["TSLA", "NVDA"]
    blacklist: []                # Never trade these: ["BBBY", "AMC"]
    
    # Universe to scan (base list for discovery)
    universe:
      - "TSLA"
      - "NVDA"
      - "AMD"
      - "AAPL"
      - "MSFT"
      - "GOOGL"
      - "META"
      - "AMZN"
      - "GME"
      - "PLTR"
      - "SOFI"
      - "COIN"
      - "MSTR"
      - "SMCI"
      - "ARM"
  
  # --------------------------------------------------------------------------
  # MOMENTUM FACTORS
  # --------------------------------------------------------------------------
  
  factors:
    volume_anomaly:
      enabled: true
      weight: 0.40
      rvol_threshold: 1.5        # Relative volume threshold
      volume_trend_threshold: 0.2
    
    reddit_attention:            # Reddit/WSB sentiment via Apewisdom (FREE!)
      enabled: true
      weight: 0.30
      mention_threshold: 50      # Min Reddit mentions to score
      velocity_weight: 0.4       # Weight for mention growth
      sentiment_weight: 0.3      # Weight for positivity
    
    sentiment_velocity:
      enabled: true
      weight: 0.30
      velocity_threshold: 10     # Messages per hour
      sentiment_threshold: 0.6   # Bullish ratio threshold
    
    # Future factors (not yet implemented)
    retail_attention:
      enabled: false             # Google Trends (rate limited)
      weight: 0.30
    options_flow:
      enabled: false
      weight: 0.20
    dark_pool:
      enabled: false
      weight: 0.10
  
  # --------------------------------------------------------------------------
  # DATA PROVIDERS
  # --------------------------------------------------------------------------
  
  providers:
    yfinance:                    # Yahoo Finance - FREE, UNLIMITED
      enabled: true
    
    apewisdom:                   # Reddit/WSB sentiment - FREE
      enabled: true              # Updates 2x daily (9 AM & 9 PM EST)
    
    google_trends:               # Google Trends - FREE but rate limited
      enabled: false             # Disabled due to 429 errors
    
    stocktwits:
      enabled: false
      use_rapidapi: true
    
    alphavantage:                # Limited to 25 req/day
      enabled: false
  
  # --------------------------------------------------------------------------
  # SCORING SETTINGS
  # --------------------------------------------------------------------------
  
  scoring:
    min_score: 0.5               # Minimum composite score
    min_confidence: 0.4          # Minimum confidence
    parallel_limit: 10           # Max parallel scoring operations
    cache_ttl: 300               # Cache scores for 5 min
  
  monitoring:
    health_check_interval: 300   # Check provider health every 5 min
    log_scores: true
    log_provider_errors: true


# ==============================================================================
# CRYPTOCURRENCY TRADING (24/7) - DISABLED BY DEFAULT
# ==============================================================================
# Crypto trades 24/7, no market hours restrictions.
# IMPORTANT: Set allocation.allow_fractional = true for crypto!

crypto:
  enabled: false                 # Master toggle for crypto trading
  
  # Crypto watchlist (only used if crypto.enabled = true)
  # Alpaca format: SYMBOL/USD
  watchlist: []
  # watchlist:
  #   - "BTC/USD"                # Bitcoin (most liquid)
  #   - "ETH/USD"                # Ethereum (most liquid)
  #   - "DOGE/USD"               # Dogecoin (high volatility!)
  #   - "SHIB/USD"               # Shiba Inu (high volatility!)
  #   - "SOL/USD"                # Solana
  #   - "LINK/USD"               # Chainlink
  #   - "LTC/USD"                # Litecoin
  #   - "AVAX/USD"               # Avalanche
  
  # Crypto-specific allocation (overrides main allocation for crypto)
  allocation:
    per_symbol_usd: 500          # Smaller positions for volatile crypto
    per_symbol_override: {}      # Override per coin: {"BTC/USD": 1000}
  
  # Crypto-specific entry strategy
  entries:
    buy_stop_pct_above_last: 3.0 # Tighter entry for 24/7 markets
    tif: "GTC"                   # GTC for crypto (no market close)
    cancel_at_close: false       # No close for crypto
  
  # Crypto-specific stops
  stops:
    trailing_stop_pct: 15.0      # Wider stops for volatile crypto
    tif: "GTC"
  
  # Crypto-specific risk
  risk:
    max_total_exposure_usd: 5000 # Lower max exposure for crypto
    max_symbol_exposure_usd: 1000
    max_concurrent_positions: 3


# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
