# Momentum Intelligence Layer Configuration
#
# Copy this to momentum_config.yaml and customize
#   cp momentum_config.yaml.example momentum_config.yaml
#
# See docs/MOMENTUM_LAYER_REQUIREMENTS.md for details

momentum_layer:
  # Master toggle
  enabled: false  # Set to true to enable momentum layer

  # Minimum thresholds for ranking
  min_score: 0.5          # Minimum composite score (0-1)
  min_confidence: 0.4     # Minimum confidence (0-1)

  # 🎯 HYBRID FILTER - Bot Integration (Option 3)
  filter:
    enabled: false        # Set to true to enable momentum filtering in bot
    min_score: 0.4        # Minimum score to allow trading (0-1)
    volume_weight: 0.7    # Weight for volume factor
    reddit_weight: 0.3    # Weight for reddit factor
    cache_duration: 3600  # Cache scores for 1 hour (seconds)
    require_volume: true  # Require volume data (recommended)
    require_reddit: false # Require reddit data (optional)
    fail_open: true       # On error, include symbol (safe default)
  
  # Factor toggles
  factors:
    volume_anomaly:
      enabled: true
      weight: 0.40
      rvol_threshold: 1.5        # RVOL threshold for signal
      volume_trend_threshold: 0.2 # Volume trend threshold
    
      retail_attention:
        enabled: false  # DISABLED - Use reddit_attention (Apewisdom) instead
        weight: 0.30
        timeframe: "now 7-d"        # Google Trends timeframe
        breakout_weight: 0.4        # Weight for breakout detection
        velocity_weight: 0.4        # Weight for search velocity
        interest_weight: 0.2        # Weight for absolute interest
    
    reddit_attention: # NEW! Reddit/WSB sentiment via Apewisdom
      enabled: true
      weight: 0.30
      mention_threshold: 50       # Minimum Reddit mentions to score
      volume_weight: 0.3          # Weight for mention volume
      velocity_weight: 0.4        # Weight for mention growth
      sentiment_weight: 0.3       # Weight for positivity score
    
    sentiment_velocity:
      enabled: true
      weight: 0.30
      velocity_threshold: 10      # Messages per hour
      sentiment_threshold: 0.6    # Bullish ratio threshold
    
    # Future factors (not yet implemented)
    options_flow:
      enabled: false
      weight: 0.20
    
    dark_pool:
      enabled: false
      weight: 0.10
    
    borrow_rate:
      enabled: false
      weight: 0.05
    
    gamma_exposure:
      enabled: false
      weight: 0.05
  
  # Provider configuration
  providers:
    # Yahoo Finance - FREE, UNLIMITED (RECOMMENDED!)
    yfinance:
      enabled: true
      # No API key needed!
    
      # Google Trends - FREE, UNLIMITED, NO API KEY!
      google_trends:
        enabled: false  # DISABLED - Rate limits too aggressive (429 errors)
        # No API key needed!
        # Uses pytrends library
    
    # Apewisdom - Reddit/WSB sentiment (FREE!)
    apewisdom:
      enabled: true
      # No API key needed!
      # Free tier: 2x daily updates (9 AM & 9 PM EST), unlimited requests
    
    # Alpha Vantage - LIMITED to 25 requests/day
    alphavantage:
      enabled: false  # Disabled (use yfinance instead)
      # API key loaded from ALPHAVANTAGE_API_KEY env var
      # Or specify here (not recommended):
      # api_key: "your_key_here"
    
    stocktwits:
      enabled: true
      use_rapidapi: true  # Use RapidAPI (recommended - free tier available)
      # RapidAPI key loaded from RAPIDAPI_KEY env var
      # Direct API token (legacy) from STOCKTWITS_ACCESS_TOKEN env var
      # Or specify here (not recommended):
      # rapidapi_key: "your_rapidapi_key_here"
      # access_token: "your_token_here"
    
    marketstack:
      enabled: false
      # Enable as fallback for Alpha Vantage
    
    unusualwhales:
      enabled: false
      # Premium options flow (requires subscription)
    
    s3_partners:
      enabled: false
      # Premium borrow data (requires subscription)
  
  # Scoring settings
  scoring:
    # Parallel limit for scoring operations
    parallel_limit: 10
    
    # Cache TTL for scores (seconds)
    cache_ttl: 300  # 5 minutes
    
    # Universe to scan (if not using watchlist)
    # universe_file: "universe.txt"  # One symbol per line
  
  # Dynamic watchlist settings
  dynamic_watchlist:
    enabled: false  # Use momentum-generated watchlist
    max_symbols: 20  # Max symbols in dynamic watchlist
    update_interval: 3600  # Update every hour (seconds)
    
    # Universe to scan for dynamic watchlist
    universe:
      - "TSLA"
      - "NVDA"
      - "AMD"
      - "AAPL"
      - "MSFT"
      - "GOOGL"
      - "META"
      - "AMZN"
      - "GME"
      - "AMC"
      - "BBBY"
      # Add more symbols to scan
  
  # Monitoring
  monitoring:
    health_check_interval: 300  # Check provider health every 5 min
    log_scores: true  # Log individual factor scores
    log_provider_errors: true

