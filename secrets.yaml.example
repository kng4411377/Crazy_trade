# API Secrets
# 
# Copy this file to secrets.yaml and add your real API keys
# DO NOT commit secrets.yaml to Git!

# Alpaca Trading API
# Get your keys from: https://app.alpaca.markets/paper/dashboard/overview
alpaca:
  api_key: "YOUR_ALPACA_API_KEY_HERE"
  secret_key: "YOUR_ALPACA_SECRET_KEY_HERE"

# Google Gemini AI (Optional - for AI analysis layer)
# Get your key from: https://aistudio.google.com/app/apikey
gemini:
  api_key: "YOUR_GEMINI_API_KEY_HERE"

