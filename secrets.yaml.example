# ==============================================================================
# CRAZY TRADE BOT - SECRETS (single file for all API keys)
# ==============================================================================
#
# Copy this file and add your real keys:
#   cp secrets.yaml.example secrets.yaml
#
# secrets.yaml is gitignored - it will never be committed.
# This is the ONLY file you need for secrets; .env is optional/legacy.
#
# Usage:
#   1. Required: alpaca.api_key and alpaca.secret_key (Alpaca trading)
#   2. Optional: gemini.api_key (for AI analysis layer)
#   3. Optional: env: section - keys here are exported to the environment
#      so momentum providers (Alpha Vantage, RapidAPI, etc.) can use them
#      via os.getenv(). Only add keys you use.
#
# See docs/SETUP_SECRETS.md for full guide.
# ==============================================================================

# ------------------------------------------------------------------------------
# Alpaca Trading API (required)
# Get keys: https://app.alpaca.markets/paper/dashboard/overview
# ------------------------------------------------------------------------------
alpaca:
  api_key: "YOUR_ALPACA_API_KEY_HERE"
  secret_key: "YOUR_ALPACA_SECRET_KEY_HERE"

# ------------------------------------------------------------------------------
# Google Gemini AI (optional - for AI analysis layer)
# Get key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
gemini:
  api_key: "YOUR_GEMINI_API_KEY_HERE"

# ------------------------------------------------------------------------------
# Optional: export to environment (for momentum layer / 12-factor)
# Keys listed here are set in os.environ when config loads, so code that
# uses os.getenv('ALPHAVANTAGE_API_KEY') etc. will see these values.
# Only uncomment and set keys you actually use.
# ------------------------------------------------------------------------------
# env:
#   # Momentum / data providers (see docs/MOMENTUM_CONFIG_GUIDE.md)
#   # ALPHAVANTAGE_API_KEY: ""
#   # RAPIDAPI_KEY: ""
#   # STOCKTWITS_USE_RAPIDAPI: "true"
#   # APEWISDOM_API_KEY: ""
#   # Tavily Search (Deep Research fallback)
#   # TAVILY_API_KEY: ""
#   # Logging (optional override)
#   # LOG_LEVEL: "INFO"
